{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "leader",
  "plugins": ["@dietrichgebert/ponytail"],
  "instructions": ["artifacts/*.md"],
  "mcp": {
    "servers": {
      "bun-docs": {
        "type": "remote",
        "url": "https://bun.com/docs/mcp",
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["bunx", "chrome-devtools-mcp@latest", "--headless"],
      },
      "tailwindcss-gitmcp": {
        "type": "remote",
        "url": "https://gitmcp.io/tailwindlabs/tailwindcss",
      },
      "solid-start-gitmcp": {
        "type": "remote",
        "url": "https://gitmcp.io/solidjs/solid-start",
      },
    },
  },
}
