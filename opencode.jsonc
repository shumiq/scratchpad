{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "orchestrator",
  "plugins": ["@dietrichgebert/ponytail"],
  "instructions": ["artifacts/*.md"],
  "mcp": {
    "bun-docs": {
      "type": "remote",
      "url": "https://bun.com/docs/mcp",
      "enabled": true,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["bunx", "chrome-devtools-mcp@latest", "--headless"],
      "enabled": true,
    },
    "tailwindcss-gitmcp": {
      "type": "remote",
      "url": "https://gitmcp.io/tailwindlabs/tailwindcss",
      "enabled": true,
    },
    "solid-start-gitmcp": {
      "type": "remote",
      "url": "https://gitmcp.io/solidjs/solid-start",
      "enabled": true,
    },
  },
}
