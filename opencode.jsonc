{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "leader",
  "plugins": ["@dietrichgebert/ponytail"],
  "instructions": ["artifacts/*.md"],
  "permissions": [
    { "action": "bash", "resource": "bun run dev", "effect": "deny" },
    { "action": "bash", "resource": "bun run start", "effect": "deny" },
    { "action": "bash", "resource": "bun run preview", "effect": "deny" },
  ],
  "commands": {
    "plan": {
      "description": "Generate a plan by spawning the planner agent",
      "template": "Create implementation tasks for: {{args}}",
      "agent": "planner",
    },
    "implement": {
      "description": "Implement a specific plan from artifacts/tasks. If not specified, ask which one.",
      "template": "Implement the task(s) in artifacts/tasks/ for: {{args}}. If no task is specified, list available tasks and ask which one to implement.",
      "agent": "leader",
    },
    "continue": {
      "description": "Implement all pending tasks in artifacts/tasks without asking",
      "template": "Continue implementing all remaining tasks in artifacts/tasks/ in dependency order. Do not ask for confirmation.",
      "agent": "leader",
    },
    "commit": {
      "description": "Run the commit skill to sync docs and commit changes",
      "template": "skill commit",
    },
  },
  "mcp": {
    "servers": {
      "bun-docs": {
        "type": "remote",
        "url": "https://bun.com/docs/mcp",
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["bunx", "chrome-devtools-mcp@latest", "--headless"],
      },
      "tailwindcss-gitmcp": {
        "type": "remote",
        "url": "https://gitmcp.io/tailwindlabs/tailwindcss",
      },
      "solid-start-gitmcp": {
        "type": "remote",
        "url": "https://gitmcp.io/solidjs/solid-start",
      },
    },
  },
}
