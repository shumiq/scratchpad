{
  "name": "example-with-tailwindcss",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "deploy:vercel": "vercel --prod",
    "preview": "vite preview",
    "commit": "opencode run commit --auto --model opencode/big-pickle",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "prepare": "husky"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.0",
    "nitro": "^3.0.260610-beta",
    "solid-js": "^1.9.14",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.0.7",
    "typescript": "^7.0.2",
    "vercel": "^65.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,css,html,md,yml,yaml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
